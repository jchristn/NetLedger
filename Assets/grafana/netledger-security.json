            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, component, method) (rate(netledger_auth_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{component}} {{method}}"
        }
      ]
    },
