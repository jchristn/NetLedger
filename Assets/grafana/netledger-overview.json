{
  "uid": "netledger-overview",
  "title": "NetLedger - Overview",
  "description": "One-glance health: are the services up, is traffic flowing, are errors rising, is archival keeping up. Start here and drill into the domain dashboards.",
  "tags": [
    "netledger",
    "overview"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "NetLedger dashboards",
      "type": "dashboards",
      "tags": [
        "netledger"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(netledger_build_info, job)",
          "refId": "job"
        },
        "definition": "label_values(netledger_build_info, job)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "id": 1,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**NetLedger Overview.** Start here. Drill down via the *NetLedger dashboards* menu: **HTTP** (slow or failing routes), **Ledger** (operations, commits, locks), **Database** (round trips per provider), **Archival Pipeline** (export stages and the automatic worker), **Integrations & Storage** (Archive Server, S3, introspection), **Auth & Request History**, **Runtime**. Failed traces and warning logs are at the bottom of this page."
      }
    },
    {
      "type": "row",
      "title": "Health",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Services up",
      "description": "Number of NetLedger Watson listeners reporting up.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(watson_server_up{job=~\"$job\"})",
          "refId": "A",
          "instant": true
        }
      ]
    },
