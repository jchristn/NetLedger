          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, histogram_quantile(0.99, sum by (le, operation) (rate(netledger_ledger_operation_duration_seconds_bucket{job=~\"$job\"}[15m]))))",
          "refId": "A",
          "instant": true,
          "format": "table"
