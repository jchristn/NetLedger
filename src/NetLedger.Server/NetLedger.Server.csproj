<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<Version>4.0.0</Version>
		<Authors>Joel Christner</Authors>
		<Company>Joel Christner</Company>
		<Description>REST API server for NetLedger active-data APIs, archive export, retention-boundary enforcement, authentication, authorization, and dashboard workflows.</Description>
		<Copyright>(c)2025 Joel Christner</Copyright>
		<PackageProjectUrl>https://github.com/jchristn/NetLedger</PackageProjectUrl>
		<RepositoryUrl>https://github.com/jchristn/NetLedger</RepositoryUrl>
		<RepositoryType>github</RepositoryType>
		<PackageReleaseNotes>NetLedger Server v4.0.0 active archive configuration, retention-boundary enforcement, automatic archival worker, active export APIs, and typed CORS settings.</PackageReleaseNotes>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
	</PropertyGroup>

	<PropertyGroup>
	  <NoWarn>1701;1702;CS8604;CS8600</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\NetLedger\NetLedger.csproj" />
		<ProjectReference Include="..\NetLedger.Archive\NetLedger.Archive.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SyslogLogging" Version="2.2.1" />
		<PackageReference Include="Timestamps" Version="1.0.12" />
		<PackageReference Include="Watson" Version="7.1.0" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="clean.bat">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="clean.sh">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
