<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<Version>4.0.0</Version>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Authors>Joel Christner</Authors>
		<Company>Joel Christner</Company>
		<Description>Tenant-aware ledgering library for debit/credit workflows, pending and committed entries, balance-chain verification, metadata search, active retention boundaries, and SQLite, MySQL, PostgreSQL, and SQL Server storage.</Description>
		<Copyright>(c)2026 Joel Christner</Copyright>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageProjectUrl>https://github.com/jchristn/NetLedger</PackageProjectUrl>
		<PackageIcon>icon.jpg</PackageIcon>
		<RepositoryUrl>https://github.com/jchristn/NetLedger</RepositoryUrl>
		<RepositoryType>github</RepositoryType>
		<PackageTags>ledger finance credit debit balance commit pending bank banking finance account accounting expense expenses cash flow profit loss income archive retention cold-storage</PackageTags>
		<PackageReleaseNotes>Major version 4.0.0: archive integration settings, NetLedger Archive Server support, active data retention policy, CORS configuration, and dashboard archive querying.</PackageReleaseNotes>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DocumentationFile>NetLedger.xml</DocumentationFile>
		<Nullable>enable</Nullable>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0|AnyCPU'">
	  <NoWarn>1701;1702;CS4014;CS8600;CS8602;CS8601;CS8603;CS8604;CS8618;CS8625;CS8629</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0|AnyCPU'">
	  <NoWarn>1701;1702;CS4014;CS8600;CS8602;CS8601;CS8603;CS8604;CS8618;CS8625;CS8629</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0|AnyCPU'">
	  <NoWarn>1701;1702;CS4014;CS8600;CS8602;CS8601;CS8603;CS8604;CS8618;CS8625;CS8629</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0|AnyCPU'">
	  <NoWarn>1701;1702;CS4014;CS8600;CS8602;CS8601;CS8603;CS8604;CS8618;CS8625;CS8629</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Update="LICENSE.md">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="NetLedger.xml">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="..\..\README.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="Assets\icon.jpg">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="LICENSE.md">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AsyncKeyedLock" Version="8.0.2" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
		<PackageReference Include="MySqlConnector" Version="2.6.1" />
		<PackageReference Include="Npgsql" Version="10.0.3" />
		<PackageReference Include="Padlock" Version="1.0.4" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
		<PackageReference Include="PrettyId" Version="2.0.1" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" />
		<PackageReference Include="Timestamps" Version="1.0.12" />
	</ItemGroup>

</Project>
